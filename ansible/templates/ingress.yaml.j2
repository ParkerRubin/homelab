# Generated by Ansible from services.yml. Edit services.yml, not this file.
apiVersion: traefik.io/v1alpha1
kind: ServersTransport
metadata:
  name: insecure-tls
  namespace: default
spec:
  insecureSkipVerify: true
{% for s in services if s.ingress | default(true) %}
{% if s.external is defined %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ s.name }}
  namespace: {{ s.namespace }}
{% if s.scheme | default('http') == 'https' %}
  annotations:
    traefik.ingress.kubernetes.io/service.serversscheme: https
    traefik.ingress.kubernetes.io/service.serverstransport: default-insecure-tls@kubernetescrd
{% endif %}
spec:
  ports:
  - port: {{ s.port }}
    targetPort: {{ s.port }}
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: {{ s.name }}-external
  namespace: {{ s.namespace }}
  labels:
    kubernetes.io/service-name: {{ s.name }}
addressType: IPv4
ports:
- port: {{ s.port }}
endpoints:
- addresses: ["{{ s.external }}"]
{% endif %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ s.name }}
  namespace: {{ s.namespace }}
spec:
  ingressClassName: traefik
  rules:
  - host: {{ s.host | default(s.name) }}.{{ lab_domain }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: {{ s.service | default(s.name) }}
            port:
              number: {{ s.port }}
{% endfor %}
